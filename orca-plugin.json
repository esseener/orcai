{
  "manifestVersion": 2,
  "id": "orzic",
  "name": "Orzic",
  "version": "0.1.2",
  "description": "Orzic - OMP plan-mode routing: plan with one model, approve, then execute with another in the same session.",
  "engines": {
    "orca": ">=1.4.268"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "orzic",
        "title": "Orzic",
        "icon": "blocks",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "events": []
  },
  "capabilities": [
    {
      "kind": "storage:own"
    }
  ]
}