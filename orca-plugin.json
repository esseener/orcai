{
  "manifestVersion": 2,
  "id": "orcai",
  "publisher": "esseener",
  "name": "Orcai",
  "version": "0.2.2",
  "description": "Orca sidebar for OMP: plan/execute model routing, live agent sessions, and out-of-session acceptance review.",
  "author": {
    "name": "esseener",
    "url": "https://github.com/esseener"
  },
  "repository": "https://github.com/esseener/orcai",
  "homepage": "https://github.com/esseener/orcai",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.268"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "orzic",
        "title": "Orcai",
        "icon": "blocks",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:read"
    }
  ]
}
