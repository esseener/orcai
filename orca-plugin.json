{
  "manifestVersion": 2,
  "id": "orzic",
  "name": "Orcai",
  "version": "0.1.25",
  "description": "Orcai - plugin host for multiple modules. Orzic (Fusion) routes plan/execute models and runs acceptance out of session.",
  "engines": {
    "orca": ">=1.4.268"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "orzic",
        "title": "Orcai",
        "icon": "blocks",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:read"
    }
  ]
}
